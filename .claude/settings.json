{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/privacy_gate.py\"",
            "timeout": 30,
            "statusMessage": "Privacy gate: checking training data approval"
          }
        ]
      }
    ]
  }
}
